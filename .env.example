# Madras Social — environment variables.
# Copy to .env.local for local dev; set the same keys in the Vercel project.
# Every key is optional: the site builds and renders without any of them,
# and the feature that needs it fails gracefully.

# Supabase — leads, reservations and enquiry rows.
# Unset: forms tell the visitor submission is unavailable instead of failing
# silently (src/integrations/supabase/client.ts).
# Do not point these at the Madras Mami project (supabase/config.toml) — see PENDING.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Resend — newsletter sign-up (api/newsletter-signup.ts, server-side only).
# Unset API key: the endpoint logs and returns an error, no contact is created.
# Unset segment id: falls back to the default segment id in that file.
RESEND_API_KEY=
RESEND_MADRAS_SOCIAL_SEGMENT_ID=
